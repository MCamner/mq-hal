#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"

while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$DIR/$TARGET"
  fi
done

ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

case "${1:-}" in
  audit)
    shift || true
    exec python3 "$ROOT/scripts/audit.py" "$@"
    ;;

  brief)
    shift || true
    exec python3 "$ROOT/scripts/brief.py" "$@"
    ;;

  release-brief|release)
    shift || true
    exec python3 "$ROOT/scripts/release_brief.py" "$@"
    ;;

  repo-status|repo)
    shift || true
    exec python3 "$ROOT/scripts/repo_status.py" "$@"
    ;;

  ci|ci-status)
    shift || true
    exec python3 "$ROOT/scripts/ci_status.py" "$@"
    ;;

  doctor|doctor-summary|--doctor-summary)
    shift || true
    exec python3 "$ROOT/scripts/doctor_summary.py" "$@"
    ;;

  fix-doctor|doctor-fix|fix-planner|plan-fix)
    shift || true
    exec python3 "$ROOT/scripts/fix_planner.py" "$@"
    ;;

  session|memory)
    shift || true
    exec python3 "$ROOT/scripts/session_memory.py" session "$@"
    ;;

  last)
    shift || true
    exec python3 "$ROOT/scripts/session_memory.py" last "$@"
    ;;

  remember)
    shift || true
    exec python3 "$ROOT/scripts/session_memory.py" remember "$@"
    ;;

  timeline)
    shift || true
    exec python3 "$ROOT/scripts/timeline.py" "$@"
    ;;

  memory-path|session-path)
    shift || true
    exec python3 "$ROOT/scripts/session_memory.py" path "$@"
    ;;
esac

exec python3 "$ROOT/scripts/hal.py" "$@"
