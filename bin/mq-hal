#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"

while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" == /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$DIR/$TARGET"
  fi
done

ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

if [[ $# -eq 0 ]]; then
  exec python3 "$ROOT/hal/dashboard.py"
fi

case "${1:-}" in
  audit)
    shift || true
    exec python3 "$ROOT/scripts/audit.py" "$@"
    ;;

  stack|stack-status|status-stack|status)
    shift || true
    exec python3 "$ROOT/scripts/stack_status.py" "$@"
    ;;

  brief)
    shift || true
    exec python3 "$ROOT/scripts/brief.py" "$@"
    ;;

  release-brief)
    shift || true
    exec python3 "$ROOT/scripts/release_brief.py" "$@"
    ;;

  release)
    shift || true
    exec python3 "$ROOT/hal/release.py" "$@"
    ;;

  runtime)
    shift || true
    exec python3 "$ROOT/hal/runtime.py" "$@"
    ;;

  route)
    shift || true
    exec python3 "$ROOT/hal/route.py" "$@"
    ;;

  dashboard)
    shift || true
    exec python3 "$ROOT/hal/dashboard.py" "$@"
    ;;

  repo-status|repo)
    shift || true
    exec python3 "$ROOT/scripts/repo_status.py" "$@"
    ;;

  ci|ci-status)
    shift || true
    exec python3 "$ROOT/scripts/ci_status.py" "$@"
    ;;

  doctor|doctor-summary|--doctor-summary)
    shift || true
    exec python3 "$ROOT/scripts/doctor_summary.py" "$@"
    ;;

  fix-doctor|doctor-fix|fix-planner|plan-fix)
    shift || true
    exec python3 "$ROOT/scripts/fix_planner.py" "$@"
    ;;

  session|memory)
    shift || true
    exec python3 "$ROOT/scripts/session_memory.py" session "$@"
    ;;

  last)
    shift || true
    exec python3 "$ROOT/scripts/session_memory.py" last "$@"
    ;;

  remember)
    shift || true
    exec python3 "$ROOT/scripts/session_memory.py" remember "$@"
    ;;

  timeline)
    shift || true
    exec python3 "$ROOT/scripts/timeline.py" "$@"
    ;;

  history)
    shift || true
    exec python3 "$ROOT/hal/history.py" "$@"
    ;;

  alerts)
    shift || true
    exec python3 "$ROOT/hal/history.py" --alerts "$@"
    ;;

  next)
    shift || true
    exec python3 "$ROOT/hal/operator.py" "$@"
    ;;

  fix)
    shift || true
    exec python3 "$ROOT/hal/operator.py" --command fix "$@"
    ;;

  open)
    shift || true
    exec python3 "$ROOT/hal/operator.py" --command open "$@"
    ;;

  memory-path|session-path)
    shift || true
    exec python3 "$ROOT/scripts/session_memory.py" path "$@"
    ;;

  memory-status|memory-brief)
    shift || true
    exec python3 "$ROOT/scripts/memory_status.py" "$@"
    ;;

  brain)
    shift || true
    exec python3 "$ROOT/hal/brain.py" "$@"
    ;;

  context)
    shift || true
    exec python3 "$ROOT/hal/context.py" "$@"
    ;;

  index)
    shift || true
    exec python3 "$ROOT/scripts/repo_memory.py" index "$@"
    ;;

  search)
    shift || true
    exec python3 "$ROOT/scripts/repo_memory.py" search "$@"
    ;;

  ask-repo)
    shift || true
    exec python3 "$ROOT/scripts/repo_memory.py" ask-repo "$@"
    ;;

  repo-map)
    shift || true
    exec python3 "$ROOT/scripts/repo_memory.py" repo-map "$@"
    ;;

  agent-brief|agent)
    shift || true
    exec python3 "$ROOT/scripts/agent_brief.py" "$@"
    ;;

  hello|status-screen)
    shift || true
    exec python3 "$ROOT/scripts/hello.py" "$@"
    ;;

  tools)
    shift || true
    exec python3 "$ROOT/scripts/tools_list.py" "$@"
    ;;

  models|model-profiles)
    shift || true
    exec python3 "$ROOT/scripts/models_list.py" "$@"
    ;;

  model-status)
    shift || true
    exec python3 "$ROOT/scripts/model_status.py" "$@"
    ;;

  model-test)
    shift || true
    exec python3 "$ROOT/scripts/model_test.py" "$@"
    ;;

  version|--version)
    shift || true
    exec python3 "$ROOT/scripts/version.py" "$@"
    ;;

  config-check|config)
    shift || true
    exec python3 "$ROOT/scripts/config_check.py" "$@"
    ;;

  update|upgrade)
    shift || true
    exec python3 "$ROOT/scripts/update.py" "$@"
    ;;

  analyze-diagram)
    shift || true
    exec python3 "$ROOT/scripts/visual_hal.py" analyze-diagram "$@"
    ;;

  review-ui)
    shift || true
    exec python3 "$ROOT/scripts/visual_hal.py" review-ui "$@"
    ;;

  architecture-brief)
    shift || true
    exec python3 "$ROOT/scripts/visual_hal.py" architecture-brief "$@"
    ;;

  plan)
    shift || true
    exec python3 "$ROOT/scripts/planner.py" "$@"
    ;;

  code-plan)
    shift || true
    exec python3 "$ROOT/scripts/planner.py" --model code "$@"
    ;;

  critic)
    shift || true
    exec python3 "$ROOT/scripts/critic.py" "$@"
    ;;

  execute)
    shift || true
    exec python3 "$ROOT/scripts/executor.py" "$@"
    ;;

  learn)
    shift || true
    exec python3 "$ROOT/scripts/learn.py" "$@"
    ;;

  env-status|env)
    shift || true
    exec python3 "$ROOT/scripts/env_status.py" "$@"
    ;;
esac

exec python3 "$ROOT/scripts/hal.py" "$@"
